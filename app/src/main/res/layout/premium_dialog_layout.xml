<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp">


        <TextView
            android:id="@+id/heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fmarjunnsinhala"
            android:text="f,dla ù we;æ"
            android:textColor="@color/Heading"
            android:textSize="44sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/confidence"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fmarjunnsinhala"
            android:layout_marginTop="10sp"
            android:gravity="center"
            android:textColor="@color/purple_1"
            android:text="wkaf,dla lsÍug m%sñhï .sKqula lr.kak'"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageContainer" />

        <androidx.cardview.widget.CardView
            android:id="@+id/imageContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            app:cardCornerRadius="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/heading">
                <ImageView
                    android:id="@+id/dialog_image"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="0dp"
                    app:srcCompat="@drawable/correct_animal_image"
                    />
        </androidx.cardview.widget.CardView>


        <Button
            android:id="@+id/button"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#d2a848"
            android:fontFamily="@font/fmarjunnsinhala"
            android:textStyle="bold"
            android:textSize="34sp"
            android:text="wkaf,dla lrkak"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/confidence" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>